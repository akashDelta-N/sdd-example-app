@host = http://localhost:5097

### List notes
GET {{host}}/api/notes
Accept: application/json

### Search notes
GET {{host}}/api/notes?search=lisbon
Accept: application/json

### Create a root note-location
# @name createNote
POST {{host}}/api/notes
Content-Type: application/json

{
  "title": "Lisbon",
  "body": "Pastel de nata in Belem, tram 28 at sunset.",
  "latitude": 38.7223,
  "longitude": -9.1393,
  "parentId": null
}

### Get a single note
GET {{host}}/api/notes/{{createNote.response.body.id}}
Accept: application/json

### Update a note
PUT {{host}}/api/notes/{{createNote.response.body.id}}
Content-Type: application/json

{
  "title": "Lisbon day 1 (revised)",
  "body": "Book the castle in advance.",
  "latitude": 38.7223,
  "longitude": -9.1393,
  "parentId": null
}

### Archive a note-location
POST {{host}}/api/notes/{{createNote.response.body.id}}/archive

### Delete a note
DELETE {{host}}/api/notes/{{createNote.response.body.id}}

### Validation error (empty title -> 400)
POST {{host}}/api/notes
Content-Type: application/json

{
  "title": "Missing position",
  "body": "",
  "latitude": 91,
  "longitude": 0,
  "parentId": null
}

###
